# ===== CONFIGURAÇÕES DE PRODUÇÃO - MOVASE BACKEND =====
# ⚠️  NUNCA commitar este arquivo no Git!
# ⚠️  Use apenas em servidor de produção

# ===== CONFIGURAÇÕES DO BANCO DE DADOS =====
DB_HOST=seu-servidor-postgresql.com
DB_PORT=5432
DB_NAME=movase_production
DB_USER=movase_user
DB_PASS=sua_senha_super_segura_aqui

# ===== CONFIGURAÇÕES DO SERVIDOR =====
PORT=3001
NODE_ENV=production

# ===== CONFIGURAÇÕES DE EMAIL (PRODUÇÃO) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@movase.com
SMTP_PASS=sua_senha_de_app_gmail

# ===== CONFIGURAÇÕES DE DOMÍNIO =====
FRONTEND_URL=https://movase.com
BACKEND_URL=https://api.movase.com
ADMIN_EMAILS=admin@movase.com,suporte@movase.com

# ===== CONFIGURAÇÕES DE SEGURANÇA =====
JWT_SECRET=sua_chave_jwt_super_segura_para_producao_2024
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ===== CONFIGURAÇÕES DE CORS =====
CORS_ORIGIN=https://movase.com,https://www.movase.com
CORS_CREDENTIALS=true

# ===== CONFIGURAÇÕES DE RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== CONFIGURAÇÕES DE LOGS =====
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/movase/backend.log

# ===== CONFIGURAÇÕES DE MONITORAMENTO =====
NEW_RELIC_LICENSE_KEY=sua_chave_new_relic
NEW_RELIC_APP_NAME=Movase-Backend

# ===== CONFIGURAÇÕES DE PAGAMENTO (PAGSEGURO) =====
PAGSEGURO_EMAIL=contato@movase.com
PAGSEGURO_TOKEN=sua_token_pagseguro_producao
PAGSEGURO_SANDBOX=false

# ===== CONFIGURAÇÕES DE CORREIOS =====
CORREIOS_CEP_ORIGEM=01001000
CORREIOS_CODIGO_EMPRESA=seu_codigo_correios
CORREIOS_SENHA=sua_senha_correios

# ===== CONFIGURAÇÕES DE UPLOAD =====
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=/var/www/movase/uploads
AWS_S3_BUCKET=movase-uploads
AWS_ACCESS_KEY_ID=sua_access_key_aws
AWS_SECRET_ACCESS_KEY=sua_secret_key_aws
AWS_REGION=us-east-1

# ===== CONFIGURAÇÕES DE CACHE (REDIS) =====
REDIS_HOST=seu-servidor-redis.com
REDIS_PORT=6379
REDIS_PASSWORD=sua_senha_redis
REDIS_DB=0

# ===== CONFIGURAÇÕES DE BACKUP =====
BACKUP_PATH=/var/backups/movase
BACKUP_RETENTION_DAYS=30

# ===== CONFIGURAÇÕES DE SSL/TLS =====
SSL_KEY_PATH=/etc/ssl/private/movase.key
SSL_CERT_PATH=/etc/ssl/certs/movase.crt

# ===== CONFIGURAÇÕES DE PERFORMANCE =====
MAX_CONNECTIONS=100
TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=65000

# ===== CONFIGURAÇÕES DE SEGURANÇA AVANÇADA =====
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
XSS_PROTECTION=true
CONTENT_TYPE_NOSNIFF=true

# ===== CONFIGURAÇÕES DE NOTIFICAÇÕES =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/seu/webhook
TELEGRAM_BOT_TOKEN=seu_token_bot_telegram
TELEGRAM_CHAT_ID=seu_chat_id_telegram
