# 🔗 CONFIGURAÇÕES DO FRONTEND (PRODUÇÃO)
NEXT_PUBLIC_API_URL=https://api.movase.com
NEXT_PUBLIC_SITE_URL=https://movase.com

# 🗄️ CONFIGURAÇÕES DO BACKEND (PRODUÇÃO)
BACKEND_API_URL=https://api.movase.com/api

# ===== CONFIGURAÇÕES DO BANCO DE DADOS =====
DB_HOST=db.movase.com
DB_PORT=5432
DB_NAME=movase_production
DB_USER=postgres
DB_PASS=your-production-password

# ===== CONFIGURAÇÕES DO SERVIDOR =====
PORT=3001
NODE_ENV=production

# 🔐 CONFIGURAÇÕES DE AUTENTICAÇÃO
JWT_SECRET=your-super-secret-jwt-key-here-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 📧 CONFIGURAÇÕES DE EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=duartelevi02@gmail.com
SMTP_PASS=urqj sysh yfgf yzww
EMAIL_FROM=noreply@movase.com
EMAIL_REPLY_TO=suporte@movase.com
FRONTEND_URL=https://movase.com
ADMIN_EMAILS=admin@movase.com

# 💳 CONFIGURAÇÕES DE PAGAMENTO
PIX_KEY=your-pix-key-here
PAGSEGURO_EMAIL=your-pagseguro-email
PAGSEGURO_TOKEN=your-pagseguro-token
PAGSEGURO_SANDBOX=false

# 📦 CONFIGURAÇÕES DE FRETE
CORREIOS_CEP_ORIGEM=01001-000
CORREIOS_CODIGO_EMPRESA=your-correios-code
CORREIOS_SENHA=your-correios-password

# 📊 CONFIGURAÇÕES DE ANALYTICS
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# 🔔 CONFIGURAÇÕES DE NOTIFICAÇÕES
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# 🚀 CONFIGURAÇÕES DE PRODUÇÃO
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
LOG_LEVEL=warn

# 🗄️ CONFIGURAÇÕES DE CACHE
REDIS_URL=redis://redis.movase.com:6379
CACHE_TTL=300

# 📁 CONFIGURAÇÕES DE UPLOAD
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# 🔒 CONFIGURAÇÕES DE SEGURANÇA
CORS_ORIGIN=https://movase.com
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=900000
